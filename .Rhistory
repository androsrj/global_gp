mtext("True Surface of Y (Subject 1)",
side = 3, line = 1, outer = TRUE,
at = 0.27, cex = 1.1)
mtext("Predicted Surface of Y (Subject 1)",
side = 3, line = 1, outer = TRUE,
at = 0.77, cex = 1.1)
}
